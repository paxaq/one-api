# Copy to .env and fill secrets. Never commit .env.

# --- Postgres (compose service) ---
POSTGRES_USER=oneapi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=oneapi

# --- App ---
PORT=3000
THEME=open
LOG_LEVEL=info
SESSION_SECRET=0123456789abcdef0123456789abcdef  # must be 16/24/32 bytes for securecookie
MEMORY_CACHE_ENABLED=true
RELAY_TIMEOUT=300
MIN_TOPUP_USD=20
LOG_RETENTION_DAYS=30

# Email (Resend recommended on VPS without outbound SMTP)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTPFrom=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional image override after pre-build
# ONEAPI_IMAGE=localhost/unit23/one-api:vps
