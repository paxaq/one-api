# Copy to .env and fill secrets. Never commit .env.
# Production host (Phase 1): hybrid runtime — see deploy/vps/README.md
# Public URL: https://oneapi.unit23api.com (Cloudflare Tunnel; origin 80/443 closed)

# --- Postgres (compose service or Podman oneapi-pg on localhost) ---
POSTGRES_USER=oneapi
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=oneapi

# --- App ---
PORT=3000
THEME=open
LOG_LEVEL=info
# securecookie AES key material: use a string whose length is 16, 24, or 32 bytes
SESSION_SECRET=0123456789abcdef0123456789abcdef
MEMORY_CACHE_ENABLED=true
RELAY_TIMEOUT=300
MIN_TOPUP_USD=5
LOG_RETENTION_DAYS=30

# When not using compose DNS names, point at localhost-published containers:
# SQL_DSN=postgres://oneapi:change-me-strong-password@127.0.0.1:5432/oneapi?sslmode=disable
# REDIS_CONN_STRING=redis://127.0.0.1:6379/0

# Email (Resend recommended on VPS without outbound SMTP)
# Production: EMAIL_PROVIDER=resend; SMTPFrom is often stored in DB options as oneapi@unit23.xyz
# (Resend-verified domain unit23.xyz — not the product host unit23api.com)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
# Optional env fallback; production also uses options.SMTPFrom
# SMTPFrom=oneapi@unit23.xyz

# Stripe (webhook: https://oneapi.unit23api.com/api/payment/stripe/webhook)
# Minimum charge: MIN_TOPUP_USD=5 (also options.MinTopUpUSD)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional image override after pre-build
# ONEAPI_IMAGE=localhost/unit23/one-api:vps
