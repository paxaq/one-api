# Reverse proxy for one-api. Replace the hostname for production TLS.
# For IP-only smoke tests, use :80 without automatic HTTPS.

{
	# email used for Let's Encrypt registration (optional override via env not supported here)
	# admin email@example.com
}

oneapi.unit23api.com {
	encode gzip
	reverse_proxy one-api:3000
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Fallback HTTP for smoke on public IP before DNS cutover
:80 {
	encode gzip
	reverse_proxy one-api:3000
}
