# one-api Railway 部署配置
# 复制此文件到 Railway Dashboard 的 Variables 中

# 必填
PORT=3000
SQLITE_PATH=/data/one-api.db

# 可选 - 日志
LOG_LEVEL=info

# 可选 - 如需 PostgreSQL (推荐生产环境使用)
# SQL_DSN=postgres://user:password@host:5432/oneapi

# 可选 - 安全
# SESSION_SECRET=your-secret-key
# INITIAL_ROOT_TOKEN=your-root-token